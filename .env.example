# Copy to .env and fill in from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake data, unlimited) or production (real banks, Trial plan = 10 links total)
PLAID_ENV=sandbox
# Optional for ledger.py: family Zelle senders (first names), e.g. SUPPORT_SENDERS=mom,dad
SUPPORT_SENDERS=
