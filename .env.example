# Copy to .env and fill in from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake data, unlimited) or production (real banks, Trial plan = 10 links total)
PLAID_ENV=sandbox
# Optional for ledger.py: family Zelle senders (first names), e.g. SUPPORT_SENDERS=mom,dad
SUPPORT_SENDERS=

# iPhone UDID and Apple team ID for scripts/morning.sh (optional)
SWAP_DEVICE=
SWAP_TEAM=
SWAP_BUNDLE_ID=
HIDE_MERCHANTS=
# Optional: name your lower-fare ride app, and let Swap suggest it (off by default)
RIDE_APP_NAME=
RECOMMEND_RIDE_APP=
# Optional: clubs Plaid files as restaurants, comma-separated (counted as Clubs & bars)
CLUB_MERCHANTS=
